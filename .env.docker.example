# Copy this to .env beside compose.yaml on the server.
WEB_IMAGE=ghcr.io/fathah/dihliz-web-next:latest
WEB_PORT=3000

NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0

POSTGRES_DB=dihliz
POSTGRES_USER=dihliz
# Generate a URL-safe password with: openssl rand -hex 32
POSTGRES_PASSWORD=replace-with-a-long-random-hex-password

# Compose builds DATABASE_URL and DATABASE_URL_UNPOOLED from POSTGRES_* above.
DATABASE_CONNECTION_LIMIT=10
