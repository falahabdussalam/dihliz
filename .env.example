# Copy this to .env for running the app and scripts from a source checkout.
# For Docker Compose deployment, copy .env.docker.example instead.

# Local PostgreSQL credentials. Generate a URL-safe password with: openssl rand -hex 32
# Compose uses these fields for both the database and the app's connection URLs.
POSTGRES_DB="dihliz"
POSTGRES_USER="dihliz"
POSTGRES_PASSWORD="replace-with-a-long-random-hex-password"

# Local PostgreSQL connection. Keep credentials here in sync with the fields above.
# Use localhost from a source checkout; the Docker template uses the postgres service.
DATABASE_URL="postgresql://dihliz:replace-with-a-long-random-hex-password@localhost:5432/dihliz?sslmode=disable"

# Direct connection for Prisma migrations, backups, and verification scripts.
# For local PostgreSQL, use the same connection as DATABASE_URL.
DATABASE_URL_UNPOOLED="postgresql://dihliz:replace-with-a-long-random-hex-password@localhost:5432/dihliz?sslmode=disable"

# For Neon, replace the URLs above with pooled and direct connections respectively.
# DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=verify-full"
# DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=verify-full"

# Application connection pool size used by the Prisma PostgreSQL adapter.
DATABASE_CONNECTION_LIMIT="5"

# Administrator created by npm run db:seed. Set a strong password before seeding.
SEED_ADMIN_EMAIL="sysadmin@dihlizworldschool.com"
SEED_ADMIN_PASSWORD="replace-with-a-strong-password"

# Optional target for scripts/migrate-mysql-backup.ts; defaults to DATABASE_URL_UNPOOLED.
# MIGRATION_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=verify-full"

# Optional browser-test settings. School tests default to port 3108; ERP tests to 3110.
# SCHOOL_TEST_URL="http://localhost:3108"
# PLAYWRIGHT_MODULE="/absolute/path/to/playwright"

# Optional exam preview: EXAM_PREVIEW=1 uses .local/exam-next as the build directory.
# Exam browser tests require an isolated test database and a server on port 3107.
# Set EXAM_ISOLATED_TEST=1 only after configuring the isolated database URLs above.
# EXAM_PREVIEW="1"
# EXAM_ISOLATED_TEST="1"
